{
  "name": "prompt-creator",
  "version": "2.0.0",
  "description": "7 層プロンプトアーキテクチャ (Role/Context/Principles/Workflow/Constraints/Output/Evaluation) で SubAgent 向けプロンプトを生成・更新する skill 群。skill-creator 仕様準拠の orchestrator (run-prompt-create) と elicit / evaluator / 7layer worker / 3 agents で構成。skill-creator (run-build-skill Step 7.5) からも呼び出される。",
  "author": {
    "name": "xl-skills maintainers"
  },
  "owner": "team-platform",
  "since": "2026-05-20",
  "last_audited": "2026-05-22",
  "source": "plugins/prompt-creator/ (旧 doc/prompt-creator/ は deprecated)",
  "skills": [
    {"name": "run-prompt-create", "path": "skills/run-prompt-create", "kind": "run", "role": "orchestrator"},
    {"name": "run-prompt-elicit", "path": "skills/run-prompt-elicit", "kind": "run", "role": "step1-elicit"},
    {"name": "run-prompt-creator-7layer", "path": "skills/run-prompt-creator-7layer", "kind": "run", "role": "step2-build"},
    {"name": "assign-prompt-design-evaluator", "path": "skills/assign-prompt-design-evaluator", "kind": "assign", "role": "step3b-evaluator"}
  ],
  "agents": [
    {"name": "prompt-creator-interview-user", "owner_skill": "run-prompt-elicit", "responsibility_id": "R1"},
    {"name": "prompt-creator-generate-prompt", "owner_skill": "run-prompt-creator-7layer", "responsibility_id": "R2"},
    {"name": "prompt-creator-review-prompt", "owner_skill": "assign-prompt-design-evaluator", "responsibility_id": "R1"}
  ],
  "commands": {
    "run-prompt-create": "skills/run-prompt-create",
    "run-prompt-creator-7layer": "skills/run-prompt-creator-7layer"
  },
  "depends_on": [
    "skill-creator",
    "skill-governance-lint"
  ],
  "bundle_targets": [
    "xl-skills-full"
  ]
