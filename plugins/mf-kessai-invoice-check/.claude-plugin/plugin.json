{
  "name": "mf-kessai-invoice-check",
  "version": "0.1.0",
  "package_mode": "bundle",
  "description": "マネーフォワード掛け払いの請求書発行漏れを月次でチェックしNotionで管理する (本体3スキル: ref-mf-kessai-api + run-mf-invoice-db-setup + run-mf-invoice-check、任意補助1スキル: run-mf-initial-month-enrich。参照専用hook・二段確認subagent・冪等Notion upsert付き)。改善要望は `/run-skill-feedback mf-kessai-invoice-check` で投入可能 (SSOT: skill-creator/skills/run-skill-feedback、symlink 配備)。",
  "author": {
    "name": "xl-skills maintainers"
  },
  "owner": "team-platform",
  "since": "2026-06-19",
  "last_audited": "2026-06-19",
  "source": "plugins/mf-kessai-invoice-check",
  "bundle_targets": [
    "xl-skills-full"
  ],
  "bundles": [
    "xl-skills-full"
  ],
  "entry_points": {
    "skills": [
      "run-mf-invoice-check",
      "run-mf-invoice-db-setup",
      "ref-mf-kessai-api",
      "run-mf-initial-month-enrich"
    ],
    "agents": [
      "mfk-gap-verifier"
    ],
    "hooks": [
      "guard-mfk-readonly"
    ]
  },
  "permissions": {
    "network": [
      "https://api.mfkessai.co.jp",
      "https://sandbox-api.mfkessai.co.jp",
      "https://api.notion.com",
      "https://invoice.moneyforward.com",
      "https://api.biz.moneyforward.com"
    ],
    "filesystem": [
      "$CLAUDE_PLUGIN_ROOT/**",
      "$CLAUDE_PROJECT_DIR/eval-log/**",
      "$MFK_OUTPUT_DIR/eval-log/**"
    ],
    "secrets": [
      "macos-keychain:mfkessai-api-key.xl-skills/xl-skills",
      "macos-keychain:notion-api-key.xl-skills/xl-skills",
      "macos-keychain:mf-invoice-oauth.xl-skills/xl-skills"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PLUGIN_ROOT/hooks/guard-mfk-readonly.py"
          }
        ]
      }
    ]
  }
}
