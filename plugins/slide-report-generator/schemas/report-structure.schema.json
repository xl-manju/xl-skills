{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slide-report-generator/report-structure.schema.json",
  "title": "Report Structure",
  "description": "slide-report-generator の output_mode=report 決定論的入力契約。structure.schema.json（slide 版）と対になる report 版で、意匠/技術コアの共通コア $defs（theme=kanagawa-lotus 固定 / aiVisualSpec / diagramNode / diagramEdge / diagramGroup / colorVar / accentColorEnum / fontAwesomeIcon）を同一構造で共有する。slide の slides[] に対応する主配列は sections[]。各 section は読み物本文（paragraphs[]・markdown 可）と 1 項目 1 ビジュアル（visual: svg/mermaid/codex-image/none の三択＝visual-strategist の最適化結果）を持つ。render-report.js が本契約を読み report.html を決定論生成する。",
  "type": "object",
  "required": ["meta", "theme", "sections"],
  "additionalProperties": false,
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "theme": { "$ref": "#/$defs/theme" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/section" }
    }
  },

  "$defs": {

    "meta": {
      "type": "object",
      "required": ["title", "reportType", "audience", "keyMessage"],
      "additionalProperties": false,
      "properties": {
        "title":       { "type": "string", "minLength": 1, "maxLength": 120 },
        "subtitle":    { "type": "string", "maxLength": 160 },
        "reportType":  { "$ref": "#/$defs/reportTypeEnum" },
        "audience":    { "type": "string", "minLength": 1, "maxLength": 200 },
        "keyMessage":  { "type": "string", "minLength": 1, "maxLength": 240 },
        "length":      { "type": "string", "enum": ["brief", "standard", "deep"], "default": "standard", "description": "読み物の長さ方針。brief=要点先行の短報 / standard=標準 / deep=網羅的な精読向け。段落密度・セクション数の目安を与える。" },
        "language":    { "type": "string", "enum": ["ja", "en"], "default": "ja" },
        "author":      { "type": "string", "maxLength": 80 },
        "createdAt":   { "type": "string", "format": "date-time" },
        "version":     { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "schemaVersion": { "type": "string", "enum": ["1.0.0"], "default": "1.0.0" },
        "visualPolicy": {
          "type": "string",
          "enum": ["svg-first", "mermaid-first", "codex-image-first", "balanced"],
          "default": "balanced",
          "description": "ビジュアル方針。visual-strategist の三択最適化に与える既定の傾き。balanced=内容適合で都度選ぶ（推奨）。hearing-facilitator が確定する。"
        }
      }
    },

    "theme": {
      "type": "object",
      "description": "Kanagawa テーマ固定。structure.schema.json の theme と同一構造キーを共有する（意匠/技術コアの単一 SSOT）。report は A4/レター読み物レイアウト（縦スクロール HTML）だが配色・フォント・最小サイズの意匠トークンは slide と共有する。",
      "required": ["name", "accentColors"],
      "additionalProperties": false,
      "properties": {
        "name":   { "const": "kanagawa-lotus" },
        "mode":   { "type": "string", "enum": ["light", "dark"], "default": "light" },
        "accentColors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "description": "各セクションにビビッドアクセント1色以上。最大8色（セクション別配色用）。",
          "items": { "$ref": "#/$defs/accentColorEnum" }
        },
        "fontScale": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 2.0,
          "default": 1.3,
          "description": "--font-scale。本文最小 1.4rem を割らない範囲で調整する。"
        },
        "pagination": { "$ref": "#/$defs/paginationSpec" },
        "footer":     { "$ref": "#/$defs/footerSpec" },
        "header":     { "$ref": "#/$defs/headerSpec" }
      }
    },

    "paginationSpec": {
      "type": "object",
      "description": "read-through レポートの目次・進捗インジケータ設定。structure.schema.json と同一構造キー。",
      "additionalProperties": false,
      "properties": {
        "style":         { "type": "string", "enum": ["dots", "bar", "numeric", "section-dots", "none"], "default": "none" },
        "milestoneEvery":{ "type": "integer", "minimum": 0, "maximum": 20, "default": 0 },
        "showSectionHighlight": { "type": "boolean", "default": false },
        "showCurrentStep":      { "type": "boolean", "default": false }
      }
    },

    "footerSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "show":   { "type": "boolean", "default": false },
        "left":   { "type": "string", "maxLength": 80 },
        "center": { "type": "string", "maxLength": 80 },
        "right":  { "type": "string", "maxLength": 80, "description": "{page}/{total} を含めるとページ番号置換。" }
      }
    },

    "headerSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "show":          { "type": "boolean", "default": false },
        "showSection":   { "type": "boolean", "default": true },
        "showTitle":     { "type": "boolean", "default": false },
        "logoIcon":      { "type": "string", "pattern": "^fa-" }
      }
    },

    "section": {
      "type": "object",
      "description": "レポートの1セクション。read-through 粒度で paragraphs[] に文章を持ち、1項目1ビジュアル原則で visual を最大1つ持つ。readingOrder/focalPoint は visual-strategist が決める配置ヒント（任意）。",
      "required": ["id", "heading", "paragraphs"],
      "additionalProperties": false,
      "properties": {
        "id":        { "type": "string", "pattern": "^section-[a-z0-9-]+$" },
        "heading":   { "type": "string", "minLength": 1, "maxLength": 120 },
        "reportType":{ "$ref": "#/$defs/reportTypeEnum", "description": "任意。meta.reportType と別の骨格節をこのセクションに適用する場合のみ。通常は meta 側で十分。" },
        "role":      { "type": "string", "enum": ["summary", "background", "analysis", "finding", "next-action", "problem", "solution", "impact", "step", "cta", "overview", "prerequisite", "procedure", "caution", "reference", "question", "concept", "diagram-understanding", "example-application", "conclusion", "body"], "default": "body", "description": "4 reportType の骨格節（要約/背景/現状分析/所見/次アクション、課題/解決策/効果実績/導入ステップ/CTA、概要/前提/手順構造/注意点/参照、問い/核心概念/図解理解/例応用/まとめ）に対応する節役割。report-structure-designer が骨格から割り当てる。" },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "description": "読み物本文。1要素=1段落（markdown 可: 太字/箇条書き/インラインコード/リンク）。slide の長文禁止を report では緩和し文章多めを許容する。",
          "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
        },
        "visual":     { "$ref": "#/$defs/visual" },
        "readingOrder": { "$ref": "#/$defs/readingOrderEnum" },
        "focalPoint":   { "$ref": "#/$defs/focalPoint" },
        "callouts": {
          "type": "array",
          "description": "任意。注記・警告・ヒント吹き出し。",
          "items": { "$ref": "#/$defs/callout" }
        }
      }
    },

    "visual": {
      "type": "object",
      "description": "1項目1ビジュアル。kind は SVG図解 / Mermaid / Codex生成画像 / なし の三択（＋none）で、visual-strategist が内容適合で最適化する。spec の形は kind により分岐する（allOf if/then）。",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["svg", "mermaid", "codex-image", "none"] },
        "spec": { "type": "object", "description": "kind 別のビジュアル仕様。kind=none では省略。" },
        "layout": { "$ref": "#/$defs/placement" },
        "caption": { "type": "string", "maxLength": 200 },
        "alt":     { "type": "string", "maxLength": 200 },
        "rationale": { "type": "string", "maxLength": 240, "description": "この kind を選んだ根拠（visual-strategist の三択判断の記録）。" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "svg" } }, "required": ["kind"] },
          "then": { "properties": { "spec": { "$ref": "#/$defs/svgSpec" } }, "required": ["spec"] }
        },
        {
          "if": { "properties": { "kind": { "const": "mermaid" } }, "required": ["kind"] },
          "then": { "properties": { "spec": { "$ref": "#/$defs/mermaidSpec" } }, "required": ["spec"] }
        },
        {
          "if": { "properties": { "kind": { "const": "codex-image" } }, "required": ["kind"] },
          "then": { "properties": { "spec": { "$ref": "#/$defs/aiVisualSpec" } }, "required": ["spec"] }
        }
      ]
    },

    "svgSpec": {
      "type": "object",
      "description": "インライン SVG2 図解。structure.schema.json の diagramSpec と共通コア（variant/nodes/edges/groups）を共有する。svg-builder.cjs の意匠トークンで描画する。",
      "required": ["variant", "nodes"],
      "additionalProperties": false,
      "properties": {
        "variant": {
          "type": "string",
          "enum": [
            "tree", "mindmap", "flow", "cycle", "pyramid", "matrix", "venn",
            "network", "timeline", "roadmap", "chevron", "funnel",
            "org", "concentric", "value-stack", "snake", "wave-step",
            "comparison", "stepper", "custom"
          ]
        },
        "viewBox": { "$ref": "#/$defs/svgViewBox" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 60,
          "items": { "$ref": "#/$defs/diagramNode" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagramEdge" }
        },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagramGroup" }
        }
      }
    },

    "mermaidSpec": {
      "type": "object",
      "description": "Mermaid 図。render-report.js が mermaid-render.js 経由で SVG/HTML 片へ変換する（CLI/lib 不在時は <pre class=\"mermaid\"> フォールバック）。definition は Mermaid 記法文字列。",
      "required": ["diagramType", "definition"],
      "additionalProperties": false,
      "properties": {
        "diagramType": {
          "type": "string",
          "enum": ["flowchart", "sequence", "class", "state", "er", "gantt", "pie", "mindmap", "timeline", "journey", "gitgraph", "quadrant", "requirement"]
        },
        "definition": { "type": "string", "minLength": 1, "maxLength": 6000, "description": "Mermaid 記法の本体（例: 'flowchart LR; A-->B'）。theme init は render 側で kanagawa-lotus トークンを注入するため definition に配色を直書きしない。" },
        "direction":  { "type": "string", "enum": ["TB", "TD", "BT", "LR", "RL"], "description": "flowchart/graph の向き。definition に含める場合は任意。" },
        "fallback":   { "type": "string", "maxLength": 400, "description": "描画不能時に表示する説明文（read-through の可読性担保）。" }
      }
    },

    "aiVisualSpec": {
      "type": "object",
      "description": "Codex Image2（gpt-image-2）生成画像の構造契約。structure.schema.json の aiVisualSpec と同一構造キーを共有する。値域は references/style-genome-packaging.md §4 と vendor/scripts/validate-ai-image-assets.js に同期する。",
      "required": ["pattern", "textPolicy", "backgroundSource", "styleGenome", "overlayText"],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^section-[a-z0-9-]+$",
          "description": "prompt/meta/asset の stem。report では section id を踏襲する。"
        },
        "pattern":          { "type": "string", "enum": ["image-only", "html-composite", "html-primary"] },
        "textPolicy":       { "type": "string", "enum": ["baked-with-overlay", "overlay-only", "none"] },
        "backgroundSource": { "type": "string", "enum": ["raster", "svg", "none"] },
        "styleGenome":      { "type": "string", "minLength": 1, "description": "project-local assets/generated/style-genome.json を推奨。" },
        "styleReference":   { "type": "string", "description": "同一画風を固定する参照画像パス。" },
        "source":           { "type": "string", "default": "text-to-image-backend", "description": "実際に使った画像生成バックエンド。codex 単体を画像生成器扱いしない。" },
        "decision":         { "type": "string", "enum": ["generate-image", "use-svg-background", "html-only"], "default": "generate-image" },
        "reason":           { "type": "string", "minLength": 1, "maxLength": 200 },
        "alt":              { "type": "string", "maxLength": 200 },
        "asset":            { "type": "string", "description": "raster 使用時の WebP/PNG パス。" },
        "prompt":           { "type": "string", "description": "prompt.md パス。backgroundSource=svg/html-primary では設計メモでもよい。" },
        "overlayText": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "bakedText": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 40 },
          "description": "textPolicy=baked-with-overlay の時だけ画像内に入れる短文。"
        },
        "diagramPrimitives": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "rounded-isometric-platform",
              "glowing-flow-arrow",
              "speech-label",
              "explanation-panel",
              "mini-table-panel",
              "tool-workbench",
              "quality-gate",
              "notion-card-stack"
            ]
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": { "properties": { "pattern": { "const": "image-only" } }, "required": ["pattern"] },
          "then": { "properties": { "textPolicy": { "enum": ["baked-with-overlay", "overlay-only"] }, "backgroundSource": { "const": "none" } } }
        },
        {
          "if": { "properties": { "pattern": { "const": "html-composite" } }, "required": ["pattern"] },
          "then": { "properties": { "textPolicy": { "const": "overlay-only" }, "backgroundSource": { "enum": ["raster", "svg"] } } }
        },
        {
          "if": { "properties": { "pattern": { "const": "html-primary" } }, "required": ["pattern"] },
          "then": { "properties": { "textPolicy": { "const": "none" }, "backgroundSource": { "enum": ["none", "svg"] } } }
        },
        {
          "if": { "properties": { "textPolicy": { "const": "baked-with-overlay" } }, "required": ["textPolicy"] },
          "then": { "required": ["bakedText"] }
        },
        {
          "if": { "properties": { "backgroundSource": { "const": "raster" } }, "required": ["backgroundSource"] },
          "then": { "required": ["asset", "prompt"] }
        }
      ]
    },

    "placement": {
      "type": "object",
      "description": "visual-strategist の配置決定。固定比率を強制しない。grid/zones はレイアウト骨組み、emphasis は強調度。",
      "additionalProperties": false,
      "properties": {
        "grid":  { "type": "string", "pattern": "^[1-9][0-9]?x[1-9][0-9]?$", "description": "レイアウトグリッド（例: '2x1' = 本文とビジュアルの左右2分割）。" },
        "zones": {
          "type": "array",
          "description": "セクション面内の領域割り当て（本文/ビジュアル/注記など）。",
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id":    { "type": "string", "minLength": 1, "maxLength": 40 },
              "role":  { "type": "string", "enum": ["prose", "visual", "callout", "caption"], "default": "visual" },
              "span":  { "type": "string", "pattern": "^[1-9][0-9]?x[1-9][0-9]?$" }
            }
          }
        },
        "emphasis": { "type": "string", "enum": ["normal", "highlight", "muted"], "default": "normal" }
      }
    },

    "callout": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "description": "注記・警告・ヒント吹き出し。structure.schema.json の diagramAnnotation と同語彙。",
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 240 },
        "kind": { "type": "string", "enum": ["note", "warning", "tip", "caution"], "default": "note" },
        "icon": { "type": "string", "pattern": "^fa-" }
      }
    },

    "readingOrderEnum": {
      "type": "string",
      "description": "視線誘導の向き。full-image-deck-method §1.11 の readingOrder と同語彙。",
      "enum": ["left-to-right", "top-to-bottom", "clockwise", "counter-clockwise", "z-shape", "radial"]
    },

    "focalPoint": {
      "type": "object",
      "description": "主ビジュアルの重心（0-100%）。full-image-deck-method §1.11 の focalPoint と同語彙。",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 100 },
        "y": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },

    "reportTypeEnum": {
      "type": "string",
      "description": "4 reportType 骨格。internal-analysis=社内報告分析（要約→背景→現状分析→所見→次アクション）/ client-proposal=顧客提案WP（課題→解決策→効果実績→導入ステップ→CTA）/ tech-doc=技術ドキュメント（概要→前提→手順構造→注意点→参照）/ learning=学習解説（問い→核心概念→図解理解→例応用→まとめ）。",
      "enum": ["internal-analysis", "client-proposal", "tech-doc", "learning"]
    },

    "diagramNode": {
      "type": "object",
      "description": "structure.schema.json と同一構造キー（共通コア）。",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id":       { "type": "string", "pattern": "^n-[a-z0-9-]+$" },
        "label":    { "type": "string", "minLength": 1, "maxLength": 60 },
        "subtext":  { "type": "string", "maxLength": 80 },
        "icon":     { "type": "string", "pattern": "^fa-" },
        "color":    { "$ref": "#/$defs/accentColorEnum" },
        "level":    { "type": "integer", "minimum": 0, "maximum": 6 },
        "weight":   { "type": "number", "minimum": 0 },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 100 },
            "y": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "shape":    { "type": "string", "enum": ["rect", "round", "circle", "hex", "diamond", "card"], "default": "rect" },
        "emphasis": { "type": "string", "enum": ["normal", "highlight", "muted", "warning"], "default": "normal" },
        "group":    { "type": "string", "description": "diagramGroup.id への参照。" }
      }
    },

    "diagramEdge": {
      "type": "object",
      "description": "structure.schema.json と同一構造キー（共通コア）。",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from":   { "type": "string", "pattern": "^n-[a-z0-9-]+$" },
        "to":     { "type": "string", "pattern": "^n-[a-z0-9-]+$" },
        "label":  { "type": "string", "maxLength": 40 },
        "kind":   { "type": "string", "enum": ["arrow", "line", "dashed", "double", "thick"], "default": "arrow" },
        "color":  { "$ref": "#/$defs/accentColorEnum" },
        "emphasis": { "type": "string", "enum": ["normal", "highlight", "muted"], "default": "normal" }
      }
    },

    "diagramGroup": {
      "type": "object",
      "description": "structure.schema.json と同一構造キー（共通コア）。",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id":     { "type": "string", "pattern": "^g-[a-z0-9-]+$" },
        "label":  { "type": "string", "maxLength": 40 },
        "color":  { "$ref": "#/$defs/accentColorEnum" },
        "kind":   { "type": "string", "enum": ["box", "tint", "outline"], "default": "box" }
      }
    },

    "accentColorEnum": {
      "type": "string",
      "description": "structure.schema.json と同一（共通コア）。",
      "enum": [
        "blue", "pink", "green", "yellow", "aqua", "violet",
        "wave-blue", "spring-violet", "sakura-pink", "wave-aqua",
        "autumn-yellow", "fuji-gray",
        "accent-blue-vivid", "accent-pink-vivid", "accent-aqua-vivid",
        "accent-violet-vivid", "accent-yellow-vivid"
      ]
    },

    "colorVar": {
      "type": "string",
      "description": "structure.schema.json と同一（共通コア）。CSS 変数表記必須。",
      "pattern": "^var\\(--[a-z0-9-]+(,\\s*#[0-9A-Fa-f]{3,8})?\\)$"
    },

    "fontAwesomeIcon": {
      "type": "string",
      "description": "structure.schema.json と同一（共通コア）。Font Awesome 6 のクラス表記。",
      "pattern": "^fa-(solid|regular|brands)\\s+fa-[a-z0-9-]+$"
    },

    "svgViewBox": {
      "type": "string",
      "description": "SVG viewBox 値。structure.schema.json と同語彙。",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?(\\s+-?[0-9]+(\\.[0-9]+)?){3}$"
    }
  }
}
