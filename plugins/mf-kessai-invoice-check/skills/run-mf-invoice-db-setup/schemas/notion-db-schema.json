{
  "title": "請求書発行チェック（マネーフォワード掛け払い）",
  "description": "発行漏れチェック結果の出力先DB。事実列(API由来)と管理列(人の運用)を分離する。",
  "properties": {
    "取引先企業名": {"type": "title"},
    "レコード種別": {"type": "select", "options": ["月次サマリ", "明細"]},
    "顧客ID": {"type": "rich_text"},
    "対象年月": {"type": "rich_text"},
    "判定": {"type": "select", "options": ["発行漏れ候補", "継続発行", "今月新規", "月次サマリ"]},
    "商品名": {"type": "rich_text"},
    "前月金額": {"type": "number"},
    "今月金額": {"type": "number"},
    "発行日": {"type": "date"},
    "更新日": {"type": "date"},
    "確認済み日時": {"type": "date"},
    "チェック実行ID": {"type": "rich_text"},
    "発行漏れ件数": {"type": "number"},
    "金額変動件数": {"type": "number"},
    "チェック件数合計": {"type": "number"},
    "請求要否": {"type": "select", "options": ["継続", "今月のみ不要", "契約終了"]},
    "対応状況": {"type": "select", "options": ["未確認", "確認中", "対応済"]},
    "チェック済": {"type": "checkbox"},
    "備考": {"type": "rich_text"}
  },
  "fact_columns": ["取引先企業名", "レコード種別", "顧客ID", "対象年月", "判定", "商品名", "前月金額", "今月金額", "発行日", "更新日", "確認済み日時", "チェック実行ID", "発行漏れ件数", "金額変動件数", "チェック件数合計"],
  "managed_columns": ["請求要否", "対応状況", "チェック済", "備考"],
  "upsert_key": ["顧客ID", "対象年月"]
}
