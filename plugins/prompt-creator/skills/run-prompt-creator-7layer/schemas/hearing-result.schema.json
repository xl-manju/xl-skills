{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Prompt作成シート ヒアリング結果",
  "description": "interview-user.md が出力するヒアリング結果JSONのスキーマ。validate_sheet.js, generate_sheet.js, scaffold_prompt.js, verify_completeness.js が入力として使用。",
  "type": "object",
  "required": [
    "prompt_name",
    "target_user",
    "purpose",
    "background",
    "success_criteria",
    "steps",
    "challenges"
  ],
  "properties": {
    "prompt_name": {
      "type": "string",
      "minLength": 1,
      "description": "素人でもこれを見ただけで分かるプロンプト名"
    },
    "target_user": {
      "type": "string",
      "minLength": 1,
      "description": "このプロンプトを実際に使う人物像や役割"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "description": "このプロンプトを作ることで達成したい最終ゴール"
    },
    "background": {
      "type": "string",
      "minLength": 1,
      "description": "なぜこのプロンプトが必要になったのか、その経緯や状況"
    },
    "success_criteria": {
      "type": "string",
      "minLength": 1,
      "description": "どのような状態になれば完成と判断できるか"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "description": "目的達成のための手順（各ステップを読んで次に何をすべきか迷わない粒度で記述）",
      "items": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "手順の説明"
          },
          "output_format": {
            "type": "string",
            "description": "このステップの出力フォーマット（変数テンプレート付き）"
          }
        }
      }
    },
    "challenges": {
      "type": "array",
      "minItems": 1,
      "description": "解決すべき課題",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_info": {
      "type": "array",
      "description": "目的を達成するために必要な情報（推奨）",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "description": "注意点・制約条件（推奨）",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prompt_issues": {
      "type": "string",
      "description": "プロンプトに対する課題（推奨）"
    },
    "test_cases": {
      "type": "array",
      "description": "テストケース（オプション）",
      "items": {
        "type": "object",
        "required": ["input", "expected_output"],
        "properties": {
          "input": {
            "type": "string",
            "minLength": 1,
            "description": "想定するユーザー入力"
          },
          "expected_output": {
            "type": "string",
            "minLength": 1,
            "description": "期待される出力"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
