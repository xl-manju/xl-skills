{
  "name": "mf-kessai-invoice-check",
  "version": "0.1.0",
  "package_mode": "bundle",
  "description": "マネーフォワード掛け払いの請求書発行漏れを月次でチェックしNotionで管理する (ref-mf-kessai-api + run-mf-invoice-db-setup + run-mf-invoice-check の3スキル構成。参照専用hook・二段確認subagent・冪等Notion upsert付き)。",
  "author": {
    "name": "xl-skills maintainers"
  },
  "owner": "team-platform",
  "since": "2026-06-19",
  "last_audited": "2026-06-19",
  "source": "plugins/mf-kessai-invoice-check",
  "bundle_targets": [
    "xl-skills-full"
  ],
  "bundles": [
    "xl-skills-full"
  ],
  "entry_points": {
    "skills": [
      "run-mf-invoice-check",
      "run-mf-invoice-db-setup",
      "ref-mf-kessai-api"
    ],
    "agents": [
      "mfk-gap-verifier"
    ],
    "hooks": [
      "guard-mfk-readonly"
    ]
  },
  "skills": [
    {
      "name": "run-mf-invoice-check",
      "path": "skills/run-mf-invoice-check",
      "kind": "run",
      "role": "monthly-invoice-gap-check"
    },
    {
      "name": "run-mf-invoice-db-setup",
      "path": "skills/run-mf-invoice-db-setup",
      "kind": "run",
      "role": "notion-db-schema-setup"
    },
    {
      "name": "ref-mf-kessai-api",
      "path": "skills/ref-mf-kessai-api",
      "kind": "ref",
      "role": "api-reference"
    }
  ],
  "agents": [
    {
      "name": "mfk-gap-verifier",
      "path": "agents/mfk-gap-verifier.md",
      "owner_skill": "run-mf-invoice-check",
      "responsibility_id": "R3"
    }
  ],
  "commands": {
    "run-mf-invoice-check": "skills/run-mf-invoice-check",
    "run-mf-invoice-db-setup": "skills/run-mf-invoice-db-setup"
  },
  "permissions": {
    "network": [
      "https://api.mfkessai.co.jp",
      "https://sandbox-api.mfkessai.co.jp",
      "https://api.notion.com"
    ],
    "filesystem": [
      "$CLAUDE_PLUGIN_ROOT/**",
      "$CLAUDE_PROJECT_DIR/eval-log/**",
      "$MFK_OUTPUT_DIR/eval-log/**"
    ],
    "secrets": [
      "macos-keychain:mfkessai-api-key.xl-skills/xl-skills",
      "macos-keychain:notion-api-key.xl-skills/xl-skills"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PLUGIN_ROOT/hooks/guard-mfk-readonly.py"
          }
        ]
      }
    ]
  }
}
