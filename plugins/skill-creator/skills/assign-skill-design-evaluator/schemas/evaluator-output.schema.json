{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xl-skills/assign-skill-design-evaluator/evaluator-output.schema.json",
  "title": "assign-skill-design-evaluator output",
  "type": "object",
  "required": ["target", "verdict", "score_per_axis", "findings"],
  "additionalProperties": false,
  "properties": {
    "target": {"type": "string"},
    "rubric_version": {"type": "string"},
    "verdict": {"type": "string", "enum": ["pass", "fail", "warn"]},
    "score_per_axis": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["score"],
        "properties": {
          "score": {"type": "integer", "minimum": 0, "maximum": 2},
          "weight": {"type": "number"}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["axis", "severity", "message"],
        "properties": {
          "axis": {"type": "string"},
          "severity": {"type": "string", "enum": ["info", "warn", "fail"]},
          "message": {"type": "string"},
          "evidence": {"type": "string"}
        }
      }
    }
  }
}
