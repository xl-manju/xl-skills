# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.python-version

# Test coverage artifacts (pytest / coverage.py が生成する揮発バイナリ / 任意階層の .coverage にマッチ)
.coverage
.coverage.*
htmlcov/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Claude Code local artifacts
.claude/logs/
.claude/secrets/

# Local config (機密含む可能性)
*.local.json
config/*.local.*
references/governance-params.json

# Secrets (絶対に commit しない)
.env
.env.*
!.env.example
.google-config.json

# Per-repo Notion config (DB IDs / keychain service identity) - see plugins/skill-creator/references/notion-per-repo-setup.md
# 検証用 config (.notion-config.test.json など .notion-config.<env>.json) は配布対象外。本番のみ example で配布。
.notion-config.json
.notion-config.*.json
!.notion-config.example.json

# Per-repo MF KESSAI config (base_url / keychain service identity / Notion DB id) - see plugins/mf-kessai-invoice-check/README.md
.mf-kessai-config.json
!.mf-kessai-config.example.json

# notion-gmail-send: 本文全文/宛先/messageId を含む plan・journal (PII 仕様書 §12) のみ git 管理外。
# content-review/elegant-review の verdict 等の設計メタ (PII 非含有・<skill>/content-review/ や _plugin/ 配下)
# は governance ゲート (lint-content-review --all) が追跡を要求するため除外しない。PII は名前パターンで限定除外。
eval-log/notion-gmail-send/plan-*.json
eval-log/notion-gmail-send/journal-*.jsonl
**/plan-*.json
# auto-send が書き出す bare 名 (plan.json / journal.jsonl) も PII を含むため除外。
# glob plan-*.json はハイフン無しの plan.json にマッチしないため明示する。
eval-log/notion-gmail-send/plan.json
eval-log/notion-gmail-send/journal.jsonl
# 例外: plugin-dev-planner の評価器ソース (plan-rubric.json=rubric SSOT /
# plan-findings.schema.json=findings schema) は PII 非含有の追跡対象ソースだが、上の
# **/plan-*.json (notion-gmail-send PII 除外) に名前衝突で巻き込まれ未追跡化するため再include する。
!plugins/plugin-dev-planner/skills/assign-plugin-plan-evaluator/references/plan-rubric.json
!plugins/plugin-dev-planner/skills/assign-plugin-plan-evaluator/schemas/plan-findings.schema.json

# Session-local artifacts
output/
.claude/handoff/
.worktrees/
# MF KESSAI ローカル作業スクラッチ (配布対象外・git 未追跡。eval-log に実顧客データを含むため
# コミット禁止。運用スクリプトは plugins/.../skills/run-mf-initial-month-enrich へ移設済み)
.mfk-run/
# run-* スキルの transient 作業ディレクトリ (skill-tree 第13条 nested dir 禁止)
.run/
# skill-intake 実行中フラグ lock (hook-guard-skillgen.py が生成・解除する揮発状態)
eval-log/intake-locks/
# .claude/{agents,skills,commands} は build-claude-symlinks.py が
# plugins/ から生成する symlink を含むため tracked。ignore しない。

# Eval-log: 一時生成物 (再現性 schema 正本は plugins/ 配下)
eval-log/skill-brief.json
eval-log/skill-brief*.json
# skill-intake eval-log は一時生成物だが content-review verdict は CI 検査対象のため追跡する
eval-log/skill-intake/**
!eval-log/skill-intake/*/
!eval-log/skill-intake/*/content-review/
!eval-log/skill-intake/*/content-review/**
eval-log/docs/
eval-log/notion-conflicts.json
# check-review-trigger.py が Stop hook で append する評価トリガキュー (揮発状態・タイムスタンプ含む)
eval-log/review-queue.jsonl
# plugin-dev-planner: run-plugin-dev-plan が生成する plan 一式 (goal-spec/progress/intermediate/
# index/specs/handoff/plan-findings) は plugin 別 scratch 作業領域 (io-contract.md §9: gitignore 対象)。
# elegant-review の run ログ (_plugin/ scratch・<skill>/elegant-review/) も本ツリー配下に出るため除外する。
# plugin ソースは plugins/ 配下、ゴールデン実例は skills/run-plugin-dev-plan/examples/ 配下で別パス=追跡継続。
# ただし content-review verdict (eval-log/<plugin>/<skill>/content-review/) は lint-content-review.py --all が
# CI で要求する成果物のため追跡を継続する (skill-intake と同じ ignore-all → content-review 再include 方式)。
eval-log/plugin-dev-planner/**
!eval-log/plugin-dev-planner/*/
!eval-log/plugin-dev-planner/*/content-review/
!eval-log/plugin-dev-planner/*/content-review/**

# Plugin-local runtime
plugins/skill-intake/output/
plugins/skill-intake/.claude/
plugins/prompt-creator/LOGS.md

# GitHub 100MB file-size limit: this local tarball cannot be pushed
google-cloud-cli-darwin-arm.tar.gz
