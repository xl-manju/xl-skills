{
  "$schema": "https://example.com/elegant-review/findings.schema.json",
  "version": 1,
  "target": {
    "type": "skill | rubric | proposal",
    "path": "<absolute path>",
    "reviewed_at": "<ISO8601>"
  },
  "loop_count": 0,
  "paradigm_findings": [
    {
      "paradigm_id": 1,
      "paradigm_name": "critical",
      "category": "A-logical",
      "agent": "elegant-logical-structural-analyst",
      "observations": ["..."],
      "issues": [
        {
          "severity": "medium",
          "condition": "C1",
          "description": "...",
          "suggested_fix": "...",
          "finding_scope": "target-specific",
          "source_tier": "internal",
          "trace_evidence": "...",
          "migration_bucket": "none",
          "reuse_surface": "none",
          "runtime_variant": "any",
          "dependency_assumption": "none",
          "negative_case": "...",
          "re_audit_trigger": "official-update | source-acquired | runtime-failure | rubric-bump | template-change | none",
          "suggested_fix_template": "..."
        }
      ],
      "score": 0.0
    }
  ],
  "variable_abstraction": {
    "policy": "具体値は再利用成果物に直書きせず、変数と既定値へ戻す",
    "variables": [
      {
        "name": "{{PROJECT_ROOT}}",
        "meaning": "対象プロジェクトのルート",
        "example_value": "/path/to/project",
        "required": true
      },
      {
        "name": "{{KIT_ROOT}}",
        "meaning": "creator-kit のルート",
        "example_value": "{{PROJECT_ROOT}}/creator-kit",
        "required": true
      }
    ],
    "source_trace": [
      {
        "concrete_value": "...",
        "variable": "{{...}}",
        "source_tier": "internal",
        "trace_evidence": "..."
      }
    ]
  },
  "four_condition_gates": {
    "C1_consistency": { "result": "PASS | FAIL", "evidence": "..." },
    "C2_completeness": { "result": "PASS | FAIL", "evidence": "..." },
    "C3_coherence": { "result": "PASS | FAIL", "evidence": "..." },
    "C4_dependency": { "result": "PASS | FAIL", "evidence": "..." }
  },
  "paradigm_coverage": {
    "expected": 30,
    "covered": 0,
    "missing_paradigms": []
  },
  "pattern_ref_candidates": [
    {
      "pattern_ref": "{{pattern_id}}",
      "reason": "...",
      "reuse_surface": "template | rubric | lint | hook | reference | manifest | runbook | none",
      "negative_case": "{{when_not_to_apply}}"
    }
  ],
  "new_patterns": [
    {
      "name": "<candidate-name>",
      "source_paradigms": ["meta", "analogy"],
      "applicability": "...",
      "negative_cases": ["..."]
    }
  ],
  "mass_production_risk": {
    "trigger_overlap": "low | medium | high",
    "naming_collision": "low | medium | high",
    "rubric_sprawl": "low | medium | high",
    "notes": "..."
  },
  "total_score": 0.0,
  "completion": {
    "all_pass": false,
    "next_action": "improve | escalate | done"
  }
}
