"""Genuine functional tests for run-build-skill/scripts/render-combinators.py.

Covers the deterministic composition core: patch selection per kind/flag, the
minimal unified-diff applier (including all error branches), frontmatter
bounds/normalization, semantic section insertion, and the feedback-loop symlink
deployment. The CLI main() is driven via subprocess on real templates and on
error inputs. No network access exists in this script (network: false), so all
paths are side-effect free except the symlink deploy, which is confined to
tmp_path.
"""
import importlib.util
import subprocess
import sys
import argparse
from pathlib import Path

import pytest

ROOT = Path(__file__).resolve().parents[2]
RUN_BUILD = ROOT / "plugins" / "harness-creator" / "skills" / "run-build-skill"
SCRIPT = RUN_BUILD / "scripts" / "render-combinators.py"
TEMPLATES = RUN_BUILD / "templates"


def _load():
    spec = importlib.util.spec_from_file_location("render_combinators", SCRIPT)
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m


mod = _load()


def _ns(**kw):
    ns = argparse.Namespace(
        kind="run",
        role_suffix="",
        with_evaluator=False,
        with_hooks=False,
        with_subagent=False,
        with_knowledge=False,
        no_goal_seek=False,
        no_feedback_loop=False,
    )
    for k, v in kw.items():
        setattr(ns, k, v)
    return ns


# ── selected_patches ─────────────────────────────────────────────────────
def test_selected_patches_run_default_on_goal_seek_and_feedback():
    assert mod.selected_patches(_ns(kind="run")) == [
        "with-run.patch",
        "with-goal-seek.patch",
        "with-feedback-contract.patch",
    ]


def test_selected_patches_ref_only_kind_patch():
    assert mod.selected_patches(_ns(kind="ref")) == ["with-ref.patch"]


def test_selected_patches_assign_defaults_to_generator():
    assert mod.selected_patches(_ns(kind="assign")) == ["with-assign-generator.patch"]


def test_selected_patches_assign_with_role_suffix():
    assert mod.selected_patches(_ns(kind="assign", role_suffix="evaluator")) == [
        "with-assign-evaluator.patch"
    ]


def test_selected_patches_no_goal_seek_opts_out():
    patches = mod.selected_patches(_ns(kind="run", no_goal_seek=True))
    assert "with-goal-seek.patch" not in patches
    assert "with-feedback-contract.patch" in patches  # still default-ON


def test_selected_patches_flags_inserted_before_goal_seek():
    patches = mod.selected_patches(_ns(kind="run", with_evaluator=True, with_hooks=True))
    assert patches == [
        "with-run.patch",
        "with-evaluator.patch",
        "with-hooks.patch",
        "with-goal-seek.patch",
        "with-feedback-contract.patch",
    ]


# ── apply_unified_diff ───────────────────────────────────────────────────
def test_apply_unified_diff_inserts_line():
    content = "line1\nline2\nline3\n"
    diff = "@@ -2,1 +2,2 @@\n line2\n+inserted\n"
    assert mod.apply_unified_diff(content, diff) == "line1\nline2\ninserted\nline3\n"


def test_apply_unified_diff_removal():
    content = "a\nb\nc\n"
    diff = "@@ -2,1 +2,0 @@\n-b\n"
    assert mod.apply_unified_diff(content, diff) == "a\nc\n"


def test_apply_unified_diff_skips_file_headers():
    content = "x\n"
    diff = "--- a/file\n+++ b/file\n@@ -1,1 +1,2 @@\n x\n+y\n"
    assert mod.apply_unified_diff(content, diff) == "x\ny\n"


def test_apply_unified_diff_invalid_header_raises():
    with pytest.raises(mod.ComposeError) as exc:
        mod.apply_unified_diff("a\n", "@@ garbage @@\n x\n")
    assert "invalid hunk header" in str(exc.value)


def test_apply_unified_diff_context_mismatch_raises():
    with pytest.raises(mod.ComposeError) as exc:
        mod.apply_unified_diff("a\nb\n", "@@ -1,1 +1,1 @@\n WRONG\n")
    assert "context mismatch" in str(exc.value)


def test_apply_unified_diff_removal_mismatch_raises():
    with pytest.raises(mod.ComposeError) as exc:
        mod.apply_unified_diff("a\nb\n", "@@ -1,1 +1,0 @@\n-WRONG\n")
    assert "removal mismatch" in str(exc.value)


def test_apply_unified_diff_overlapping_hunk_raises():
    diff = "@@ -3,1 +3,1 @@\n c\n@@ -1,1 +1,1 @@\n a\n"
    with pytest.raises(mod.ComposeError) as exc:
        mod.apply_unified_diff("a\nb\nc\n", diff)
    assert "overlapping hunk" in str(exc.value)


# ── frontmatter_bounds ───────────────────────────────────────────────────
def test_frontmatter_bounds_ok():
    assert mod.frontmatter_bounds("---\na: 1\n---\nbody\n") == (0, 2)


def test_frontmatter_bounds_requires_leading_fence():
    with pytest.raises(mod.ComposeError) as exc:
        mod.frontmatter_bounds("no fence\n")
    assert "must start with frontmatter" in str(exc.value)


def test_frontmatter_bounds_unclosed():
    with pytest.raises(mod.ComposeError) as exc:
        mod.frontmatter_bounds("---\na: 1\n")
    assert "not closed" in str(exc.value)


# ── normalize_base ───────────────────────────────────────────────────────
def test_normalize_base_strips_design_note_fence():
    txt = "---\ndesign note\n---\n---\nname: foo\n---\nbody\n"
    assert mod.normalize_base(txt) == "---\nname: foo\n---\nbody\n"


def test_normalize_base_passthrough_when_no_double_fence():
    txt = "plain content without fence\n"
    assert mod.normalize_base(txt) == txt


# ── ensure_frontmatter_line ──────────────────────────────────────────────
def test_ensure_frontmatter_line_inserts_after_key():
    fm = "---\nname: x\nkind: run\n---\nbody\n"
    out = mod.ensure_frontmatter_line(fm, "effect: local", "kind")
    assert out == "---\nname: x\nkind: run\neffect: local\n---\nbody\n"


def test_ensure_frontmatter_line_noop_when_key_present():
    fm = "---\nname: x\nkind: run\n---\nbody\n"
    assert mod.ensure_frontmatter_line(fm, "kind: other") == fm


def test_ensure_frontmatter_line_appends_at_end_without_after_key():
    fm = "---\nname: x\n---\nbody\n"
    out = mod.ensure_frontmatter_line(fm, "extra: 1")
    assert "extra: 1" in out
    # inserted before the closing fence
    assert out.index("extra: 1") < out.index("---\nbody")


# ── add_section_after ────────────────────────────────────────────────────
def test_add_section_after_inserts():
    assert (
        mod.add_section_after("A\nANCHOR\nB\n", "ANCHOR", "## New\ncontent")
        == "A\nANCHOR\n\n## New\ncontent\nB\n"
    )


def test_add_section_after_idempotent_when_section_present():
    txt = "## S\nx\n"
    assert mod.add_section_after(txt, "anything", "## S\nx") == txt


def test_add_section_after_missing_anchor_raises():
    with pytest.raises(mod.ComposeError) as exc:
        mod.add_section_after("body\n", "MISSING", "## S\nx")
    assert "anchor not found" in str(exc.value)


# ── apply_semantic_patch (pure section/frontmatter injectors) ────────────
_SEMANTIC_BASE = (
    "---\nname: x\nkind: assign\neffect: e\nrubric_refs: []\ndescription: d\n"
    "user-invocable: true\n---\n"
    "## 目的と出力契約\n{{output_contract}}\n"
    "## 主要ルール\n{{key_constraints}}\n"
    "## セキュリティと権限\n本Skillは副作用を伴う可能性がある。設計書04章の二段防御原則に従い、"
    "(1) `settings.json` の `permissions.deny` に禁止コマンド・パスを静的に列挙し、"
    "(2) `PreToolUse` hook で文脈依存の危険検査（破壊的引数・対象パス・分岐条件）を動的に行うこと。\n"
    "## 追加リソース\n- `references/`\n{{additional_resources}}\n"
)


@pytest.mark.parametrize(
    "patch,marker",
    [
        ("with-assign-evaluator.patch", "## Evaluator Contract"),
        ("with-wrap.patch", "## Wrapped CLI"),
        ("with-delegate.patch", "## Delegation Target"),
        ("with-evaluator.patch", "## Evaluator 連携"),
        ("with-hooks.patch", "## Hook Wiring"),
        ("with-subagent.patch", "## Subagent / Agent Team 連携"),
        ("with-knowledge.patch", "## ナレッジループ"),
    ],
)
def test_apply_semantic_patch_injects_section(patch, marker):
    out = mod.apply_semantic_patch(_SEMANTIC_BASE, patch)
    assert marker in out
    # the inserted section is appended after its anchor, not replacing it
    assert "## 目的と出力契約" in out


def test_apply_semantic_patch_goal_seek_needs_loop_anchor():
    base = _SEMANTIC_BASE.replace(
        "{{key_constraints}}", "{{key_constraints}}\n" + mod.GOAL_SEEK_LOOP_ANCHOR
    )
    out = mod.apply_semantic_patch(base, "with-goal-seek.patch")
    assert "### ゴールシーク配線（実行可能機構）" in out
    assert "goal_seek:" in out


def test_apply_semantic_patch_unknown_raises():
    with pytest.raises(mod.ComposeError) as exc:
        mod.apply_semantic_patch(_SEMANTIC_BASE, "with-nonexistent.patch")
    assert "unknown combinator" in str(exc.value)


# ── apply_feedback_loop ──────────────────────────────────────────────────
def test_apply_feedback_loop_creates_relative_symlink(tmp_path):
    target = tmp_path / "myplugin"
    target.mkdir()
    link = mod.apply_feedback_loop(target)
    assert link.is_symlink()
    import os

    assert os.readlink(link) == "../../harness-creator/skills/run-skill-feedback"


def test_apply_feedback_loop_is_idempotent(tmp_path):
    target = tmp_path / "p"
    target.mkdir()
    first = mod.apply_feedback_loop(target)
    second = mod.apply_feedback_loop(target)
    assert first == second
    assert first.is_symlink()


def test_apply_feedback_loop_skips_creator_self(tmp_path):
    sc = tmp_path / "harness-creator"
    sc.mkdir()
    link = mod.apply_feedback_loop(sc)
    # Returns the canonical path but creates no self-referential symlink.
    assert link.name == "run-skill-feedback"
    assert not link.exists()


# ── CLI main via subprocess ──────────────────────────────────────────────
def _run(*args):
    return subprocess.run(
        [sys.executable, str(SCRIPT), *args],
        cwd=ROOT,
        text=True,
        capture_output=True,
    )


def test_cli_run_kind_composes_stdout():
    proc = _run("--kind", "run")
    assert proc.returncode == 0, proc.stderr
    assert "feedback_contract:" in proc.stdout
    assert "## 評価・改善ループ契約" in proc.stdout


def test_cli_ref_kind_injects_read_only_frontmatter():
    proc = _run("--kind", "ref")
    assert proc.returncode == 0, proc.stderr
    assert "disable-model-invocation: true" in proc.stdout
    assert "user-invocable: false" in proc.stdout


def test_cli_invalid_kind_usage_error():
    proc = _run("--kind", "bogus")
    assert proc.returncode == 2
    assert "invalid choice" in proc.stderr


def test_cli_writes_output_file(tmp_path):
    out = tmp_path / "nested" / "SKILL.md"
    proc = _run("--kind", "ref", "--output", str(out))
    assert proc.returncode == 0, proc.stderr
    assert out.exists()
    assert "disable-model-invocation: true" in out.read_text(encoding="utf-8")


def test_cli_missing_combinator_dir_returns_1(tmp_path):
    empty = tmp_path / "templates"
    empty.mkdir()
    # No _base.md present -> OSError -> exit 1 (composition/IO failure).
    proc = _run("--kind", "run", "--templates-dir", str(empty))
    assert proc.returncode == 1
    assert "error:" in proc.stderr


def test_cli_deploy_feedback_loop_creates_symlink(tmp_path):
    target = tmp_path / "destplugin"
    target.mkdir()
    proc = _run("--kind", "ref", "--deploy-feedback-loop", str(target), "--trace")
    assert proc.returncode == 0, proc.stderr
    link = target / "skills" / "run-skill-feedback"
    assert link.is_symlink()
    assert "deployed feedback-loop" in proc.stderr
