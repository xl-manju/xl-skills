{
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(/deploy:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hook-guard-rubric.py"
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": "SKILL.md",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hook-validate-skill-md.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hook-verify-evaluator-json.py"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hook-handoff.py"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hook-post-compact.py"
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hook-check-file-ownership.py"
          }
        ]
      }
    ]
  }
}
