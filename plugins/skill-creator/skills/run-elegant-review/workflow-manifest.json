{
  "schemaVersion": 1,
  "workflowId": "run-elegant-review",
  "owner_skill": "run-elegant-review",
  "description": "Phase1 reset → Phase2 3並列分析 → Phase3 改善実行の3フェーズワークフロー。30思考法 × C1-C4 を満たすまで反復 (max 3)。",
  "phases": [
    {
      "id": "phase1-reset",
      "title": "思考リセット俯瞰",
      "agent": "../../agents/elegant-reset-observer.md",
      "parallel": false,
      "input_schema": "./schemas/phase-output.schema.json#/definitions/phase1_input",
      "output_schema": "./schemas/phase-output.schema.json#/definitions/phase1_output",
      "prompt": "./prompts/phase1-reset.md",
      "entryHookId": "phase1-entry",
      "exitHookId": "phase1-exit",
      "gate": {
        "type": "schema-validate",
        "schema": "./schemas/phase-output.schema.json#/definitions/phase1_output",
        "must_include": ["purpose", "scope", "stakeholders", "concrete_values_to_abstract"]
      }
    },
    {
      "id": "phase2-parallel",
      "title": "並列3エージェント分析",
      "dependsOn": ["phase1-reset"],
      "parallel": true,
      "agents": [
        "../../agents/elegant-logical-structural-analyst.md",
        "../../agents/elegant-meta-divergent-analyst.md",
        "../../agents/elegant-system-strategic-analyst.md"
      ],
      "input_schema": "./schemas/phase-output.schema.json#/definitions/phase2_input",
      "output_schema": "./schemas/phase-output.schema.json#/definitions/phase2_output",
      "prompt": "./prompts/phase2-parallel.md",
      "entryHookId": "phase2-entry",
      "exitHookId": "phase2-exit",
      "gate": {
        "type": "paradigm-coverage",
        "command": "python3 scripts/validate-paradigm-coverage.py",
        "schema": "./schemas/findings.schema.json",
        "must_equal": {"paradigm_findings_count": 30}
      }
    },
    {
      "id": "phase3-execute",
      "title": "改善実行",
      "dependsOn": ["phase2-parallel"],
      "agent": "../../agents/elegant-improvement-executor.md",
      "parallel": false,
      "input_schema": "./schemas/phase-output.schema.json#/definitions/phase3_input",
      "output_schema": "./schemas/phase-output.schema.json#/definitions/phase3_output",
      "prompt": "./prompts/phase3-execute.md",
      "entryHookId": "phase3-entry",
      "exitHookId": "phase3-exit",
      "gate": {
        "type": "four-conditions",
        "must_pass": ["C1", "C2", "C3", "C4"],
        "convergence_policy": "./references/convergence-policy.json",
        "max_iterations": 3,
        "on_max_iteration": "human_review"
      }
    }
  ],
  "resources": [
    {"id": "agent-reset-observer", "kind": "agent", "path": "../../agents/elegant-reset-observer.md", "phaseIds": ["phase1-reset"]},
    {"id": "agent-logical-structural", "kind": "agent", "path": "../../agents/elegant-logical-structural-analyst.md", "phaseIds": ["phase2-parallel"]},
    {"id": "agent-meta-divergent", "kind": "agent", "path": "../../agents/elegant-meta-divergent-analyst.md", "phaseIds": ["phase2-parallel"]},
    {"id": "agent-system-strategic", "kind": "agent", "path": "../../agents/elegant-system-strategic-analyst.md", "phaseIds": ["phase2-parallel"]},
    {"id": "agent-improvement-executor", "kind": "agent", "path": "../../agents/elegant-improvement-executor.md", "phaseIds": ["phase3-execute"]},
    {"id": "schema-findings", "kind": "schema", "path": "./schemas/findings.schema.json", "phaseIds": ["phase2-parallel", "phase3-execute"]},
    {"id": "schema-phase-output", "kind": "schema", "path": "./schemas/phase-output.schema.json", "phaseIds": ["phase1-reset", "phase2-parallel", "phase3-execute"]},
    {"id": "ref-4-conditions", "kind": "reference", "path": "./references/4-conditions.json", "phaseIds": ["phase2-parallel", "phase3-execute"]},
    {"id": "ref-30-paradigms", "kind": "reference", "path": "./references/30-paradigms-full.md", "phaseIds": ["phase2-parallel"]},
    {"id": "ref-convergence-policy", "kind": "reference", "path": "./references/convergence-policy.json", "phaseIds": ["phase3-execute"]},
    {"id": "ref-orchestration-flow", "kind": "reference", "path": "./references/orchestration-flow.md", "phaseIds": ["phase1-reset", "phase2-parallel", "phase3-execute"]},
    {"id": "ref-variable-template", "kind": "reference", "path": "./references/variable-template-contract.md", "phaseIds": ["phase1-reset", "phase2-parallel", "phase3-execute"]},
    {"id": "ref-amplified-patterns", "kind": "reference", "path": "./references/amplified-patterns.json", "phaseIds": ["phase3-execute"]},
    {"id": "script-validate-coverage", "kind": "script", "path": "./scripts/validate-paradigm-coverage.py", "phaseIds": ["phase2-parallel"]},
    {"id": "script-build-scorecard", "kind": "script", "path": "./scripts/build-paradigm-scorecard.py", "phaseIds": ["phase2-parallel"]}
  ],
  "entry": [
    {"id": "phase1-entry", "command": "validate target_type and target_path; ensure read-only mode"},
    {"id": "phase2-entry", "command": "validate phase1 output schema; spawn 3 agents in parallel"},
    {"id": "phase3-entry", "command": "validate aggregated findings; verify paradigm count == 30"}
  ],
  "exit": [
    {"id": "phase1-exit", "command": "handoff raw_observations.json"},
    {"id": "phase2-exit", "command": "run validate-paradigm-coverage.py and build-paradigm-scorecard.py; handoff findings.json"},
    {"id": "phase3-exit", "command": "verify C1-C4 PASS or escalate to human_review on max_iterations"}
  ]
}
