{
  "$comment": "C1-C4 機械判定ルール。LLM 判断揺れを抑えるため、できる限り regex / scripted check に落とす。",
  "version": "1.0.0",
  "C1": {
    "name": "Layer 整合",
    "checks": [
      {"id": "C1-001", "description": "L1-L7 セクションが全て存在する", "scripted": true, "rule": "regex_match", "pattern": "^## Layer [1-7]:"},
      {"id": "C1-002", "description": "Layer 番号と役割名が seven-layer-format.md と一致", "scripted": false, "severity": "high"},
      {"id": "C1-003", "description": "メタ表が name/skill/responsibility/layers_covered/output_schema/reproducible を含む", "scripted": true, "severity": "medium"}
    ]
  },
  "C2": {
    "name": "依存方向 (L7→L1 単方向)",
    "checks": [
      {"id": "C2-001", "description": "Layer N から Layer N+k (k>0) への参照がない", "scripted": false, "severity": "high"},
      {"id": "C2-002", "description": "L1 が L2-L7 を参照していない", "scripted": false, "severity": "high"},
      {"id": "C2-003", "description": "ID 参照 (@agent_n) が使われ、暗黙参照に依存していない", "scripted": false, "severity": "medium"}
    ]
  },
  "C3": {
    "name": "再現性",
    "checks": [
      {"id": "C3-001", "description": "reproducible: true がメタに明記", "scripted": true, "rule": "regex_match", "pattern": "reproducible.*true"},
      {"id": "C3-002", "description": "output_schema パスが存在する", "scripted": true, "severity": "high"},
      {"id": "C3-003", "description": "script_refs / schema_refs が同じ入力で同じ出力を保証する根拠を持つ", "scripted": false, "severity": "medium"},
      {"id": "C3-004", "description": "5.2 推論手順が 3-7 ステップで具体的", "scripted": false, "severity": "medium"}
    ]
  },
  "C4": {
    "name": "Self-Evaluation 充足",
    "checks": [
      {"id": "C4-001", "description": "5.3 self_evaluation_checklist が 5-8 項目", "scripted": true, "severity": "high"},
      {"id": "C4-002", "description": "各 checklist 項目が客観判定可能 (主語+動詞+合格条件)", "scripted": false, "severity": "high"},
      {"id": "C4-003", "description": "placeholder ({{...}}) / TODO / 英語仮文残存がない", "scripted": true, "rule": "regex_absent", "pattern": "\\{\\{[^}]+\\}\\}|TODO\\(human\\)"}
    ]
  },
  "global_thresholds": {
    "completeness_score_minimum": 0.95,
    "high_severity_max": 0,
    "medium_severity_max": 2
  }
}
